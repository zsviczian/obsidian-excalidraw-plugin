{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/zsviczian/obsidian-excalidraw-plugin/scripts/testing/features.schema.json",
  "title": "Core feature obligations and executable evidence references",
  "type": "object",
  "required": ["schemaVersion", "features", "requiredSuites", "requiredGates"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "requiredSuites": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "requiredGates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "features": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "priority", "name", "anchors", "tests", "fixtures", "platforms", "success", "failure", "cleanup", "remaining"],
        "properties": {
          "id": { "type": "string", "pattern": "^P(0[1-9]|1[0-2])$" },
          "priority": { "enum": ["P0", "P1"] },
          "remaining": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "tests": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["path", "layer", "cases"],
              "properties": {
                "repository": { "enum": ["fork", "extras"] },
                "layer": { "enum": ["source", "native", "browser", "artifact"] },
                "cases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    }
  }
}
