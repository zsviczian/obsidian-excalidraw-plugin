{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/zsviczian/obsidian-excalidraw-plugin/scripts/testing/report.schema.json",
  "title": "Excalidraw executed suite evidence, version 2",
  "type": "object",
  "required": ["schemaVersion", "suiteId", "status", "cleanup", "tests"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "suiteId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed", "blocked", "notApplicable"] },
    "cleanup": { "enum": ["passed", "failed", "not-started"] },
    "tests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["testId", "status"],
        "properties": {
          "testId": { "type": "string", "minLength": 1 },
          "featureIds": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["passed", "failed", "blocked", "notApplicable"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
